ARG NODE_IMAGE=public.ecr.aws/docker/library/node:22-bookworm-slim
FROM ${NODE_IMAGE} AS builder

WORKDIR /app
COPY . .
RUN npm ci --ignore-scripts

ARG WEB_COMMIT_SHA
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID
ARG NEXT_PUBLIC_APPLE_CLIENT_ID
ARG NEXT_PUBLIC_VAPID_PUBLIC_KEY
ARG NEXT_PUBLIC_EVENT_API_BASE
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY
ARG NEXT_PUBLIC_SENTRY_DSN
ARG NEXT_PUBLIC_PLAY_PACKAGE_NAME=org.useorbit.app
ARG NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
ARG NEXT_PUBLIC_POSTHOG_KEY
ARG NEXT_PUBLIC_UPLOAD_BUCKET_ORIGIN
ARG SENTRY_ORG
ARG SENTRY_PROJECT

ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID \
    NEXT_PUBLIC_APPLE_CLIENT_ID=$NEXT_PUBLIC_APPLE_CLIENT_ID \
    NEXT_PUBLIC_VAPID_PUBLIC_KEY=$NEXT_PUBLIC_VAPID_PUBLIC_KEY \
    NEXT_PUBLIC_EVENT_API_BASE=$NEXT_PUBLIC_EVENT_API_BASE \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_TURNSTILE_SITE_KEY=$NEXT_PUBLIC_TURNSTILE_SITE_KEY \
    NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN \
    NEXT_PUBLIC_PLAY_PACKAGE_NAME=$NEXT_PUBLIC_PLAY_PACKAGE_NAME \
    NEXT_PUBLIC_SENTRY_ENVIRONMENT=$NEXT_PUBLIC_SENTRY_ENVIRONMENT \
    NEXT_PUBLIC_POSTHOG_KEY=$NEXT_PUBLIC_POSTHOG_KEY \
    NEXT_PUBLIC_UPLOAD_BUCKET_ORIGIN=$NEXT_PUBLIC_UPLOAD_BUCKET_ORIGIN \
    NEXT_PUBLIC_WEB_COMMIT_SHA=$WEB_COMMIT_SHA \
    SENTRY_ORG=$SENTRY_ORG \
    SENTRY_PROJECT=$SENTRY_PROJECT

# WHY: The token is a build secret, so it never enters an image layer. Without it the build uploads no source map.
RUN --mount=type=secret,id=sentry_auth_token \
    SENTRY_AUTH_TOKEN="$(cat /run/secrets/sentry_auth_token 2>/dev/null || true)" \
    npx turbo run build --filter=@orbit/web

FROM ${NODE_IMAGE} AS runner
WORKDIR /app
ARG WEB_COMMIT_SHA
ARG NEXT_PUBLIC_UPLOAD_BUCKET_ORIGIN
ARG NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 WEB_COMMIT_SHA=$WEB_COMMIT_SHA \
    NEXT_PUBLIC_SENTRY_ENVIRONMENT=$NEXT_PUBLIC_SENTRY_ENVIRONMENT \
    NEXT_PUBLIC_UPLOAD_BUCKET_ORIGIN=$NEXT_PUBLIC_UPLOAD_BUCKET_ORIGIN

RUN groupadd --system orbit && useradd --system --gid orbit orbit
COPY --from=builder --chown=orbit:orbit /app/apps/web/.next/standalone ./
COPY --from=builder --chown=orbit:orbit /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=orbit:orbit /app/apps/web/public ./apps/web/public

USER orbit
EXPOSE 3000
WORKDIR /app/apps/web
CMD ["node", "server.js"]
