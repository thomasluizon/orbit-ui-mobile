.stryker-tmp/
packages/shared/.stryker-tmp/
packages/shared/reports/

# Playwright smoke (apps/web/e2e)
apps/web/e2e/.auth/
apps/web/e2e/.report/
apps/web/e2e/.results/
/test-results/
.cache/ms-playwright/

# Temporary files
.tmp/
temporary screenshots/

# Local diagnostic artifacts stay uncommitted. Visual completion comes from
# the owner reviewing the running surface on seeded data, not screenshot files.
# The surface inventory in .claude/manifests/ stays committed so coverage
# tooling and later sessions share the same surface list.
.artifacts/

# Expo
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
google-services.json
apps/mobile/play-service-account.json

# Native build outputs
apps/mobile/android/
apps/mobile/modules/*/android/.gradle/
apps/mobile/modules/*/android/.cxx/
apps/mobile/modules/*/android/build/
apps/mobile/modules/*/android/local.properties
apps/mobile/ios/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# The Codex CLI writes this diagnostic into its working directory.
error.log

.claude/sweeps/
.claude/drift-review-state.json

# foglamp scan (edit token in scan.lock.json is a secret)
.foglamp/

# Agent scratch. The patterns keep local git status quiet, but they are not the gate: the closed
# root allowlist in tools/root-allowlist.json rejects every undeclared root file regardless of name.
.tmp-*
.tmp_*
.sess-*
.session-*
.orca-*
.agent-scratch-*

/architecture.json
/architecture.html
/architecture.mmd
