{
  "description": "Thin native Codex lifecycle adapter for the canonical Claude hook programs.",
  "hooks": {
    "PreToolUse": [{ "hooks": [{ "type": "command", "command": "node .codex/hooks/lifecycle-adapter.mjs", "timeout": 10 }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "node .codex/hooks/lifecycle-adapter.mjs", "timeout": 10 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node .codex/hooks/lifecycle-adapter.mjs", "timeout": 10 }] }]
  }
}
