{
  "name": "orbit",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "eslint-rules"
  ],
  "scripts": {
    "prepare": "lefthook install || true",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "web": "turbo run dev --filter=@orbit/web",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "surfaces:manifest": "node tools/surface-manifest.mjs"
  },
  "dependencies": {
    "decode-uri-component": "file:packages/decode-uri-component"
  },
  "devDependencies": {
    "@swc/helpers": "^0.5.15",
    "ajv": "^8.20.0",
    "commander": "~15.0.0",
    "fast-check": "^4.9.0",
    "fdir": "^6.5.0",
    "html-parse-stringify": "^3.0.1",
    "indent-string": "^4.0.0",
    "lefthook": "^2.1.10",
    "min-indent": "^1.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.7",
    "sharp": "^0.35.4",
    "turbo": "^2.9.18",
    "typescript": "^6.0.2"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.0.0-rc.13",
    "@rolldown/binding-win32-x64-msvc": "^1.0.0-rc.13"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "decode-uri-component": "$decode-uri-component",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.7",
    "underscore": "^1.13.8",
    "postcss": "^8.5.18",
    "sharp": "^0.35.4",
    "tmp": "^0.2.6",
    "qs": "^6.16.0",
    "uuid": "^11.1.1",
    "brace-expansion@1": "^1.1.18",
    "nanoid@3": "^3.3.17",
    "@react-native-masked-view/masked-view": "0.3.2",
    "expo-dev-menu-interface": "57.0.0",
    "expo-structured-headers": "57.0.0",
    "react-native-device-info": "10.3.0",
    "@puppeteer/browsers": "3.2.3",
    "undici@7": "^7.29.1"
  }
}
