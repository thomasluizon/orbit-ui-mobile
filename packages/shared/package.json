{
  "name": "@orbit/shared",
  "version": "0.0.1",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./chat": "./src/chat/index.ts",
    "./chat/prompt-library": "./src/chat/prompt-library.ts",
    "./hooks": "./src/hooks/index.ts",
    "./hooks/move-parent-core": "./src/hooks/move-parent-core.ts",
    "./hooks/plan-announcement-core": "./src/hooks/plan-announcement-core.ts",
    "./types": "./src/types/index.ts",
    "./types/*": "./src/types/*.ts",
    "./contracts/*": "./src/contracts/*/index.ts",
    "./utils": "./src/utils/index.ts",
    "./utils/today-launch": "./src/utils/today-launch.ts",
    "./utils/move-parent": "./src/utils/move-parent.ts",
    "./utils/repeat-reminders": "./src/utils/repeat-reminders.ts",
    "./stores": "./src/stores/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./i18n/*": "./src/i18n/*",
    "./theme": "./src/theme/index.ts",
    "./api": "./src/api/index.ts",
    "./query": "./src/query/index.ts",
    "./test-support/validation-fixtures": "./src/test-support/validation-fixtures.ts",
    "./test-support/chat-fixtures": "./src/test-support/chat-fixtures.ts",
    "./test-support/habit-detail-fixtures": "./src/test-support/habit-detail-fixtures.ts",
    "./validation": "./src/validation/index.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:barrel-import": "vitest run --config vitest.barrel-import.config.ts",
    "test:theme": "vitest run src/__tests__/theme.test.ts",
    "generate:zod": "node scripts/generate-contract.mjs",
    "mutation": "stryker run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tanstack/query-core": "5.101.4",
    "@vvo/tzdb": "^6.202.0",
    "date-fns": "^4.4.0",
    "html-entities": "2.6.0",
    "marked": "18.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "@orval/zod": "^8.46.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "orval": "^8.46.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  }
}
