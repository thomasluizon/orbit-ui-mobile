{
  "name": "@orbit/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "./index.js",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    },
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  },
  "scripts": {
    "postinstall": "node scripts/fix-hoisting.js",
    "dev": "expo start",
    "android:apk": "node scripts/android-release-apk.js",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "expo lint",
    "lint:prune": "expo lint -- --prune-suppressions",
    "clean": "rm -rf .expo",
    "android": "node scripts/run-android.js",
    "android:apk:emulator": "node scripts/android-release-apk.js --emulator"
  },
