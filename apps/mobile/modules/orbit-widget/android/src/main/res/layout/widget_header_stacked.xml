<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_header_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/widget_header_height"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:height="48dp"
        android:includeFontPadding="false"
        android:importantForAccessibility="no"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/widget_header_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:paddingStart="@dimen/widget_row_inset_inline"
        android:layout_toStartOf="@id/widget_header_right"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:text="@string/widget_today"
            android:textAllCaps="false"
            android:textColor="@color/widget_fg_3"
            android:textSize="@dimen/widget_day_text_size" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:textColor="@color/widget_fg_3"
                android:textSize="@dimen/widget_label_text_size" />
            <LinearLayout
                android:id="@+id/widget_streak_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/widget_unit_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView
                    android:id="@+id/widget_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/widget_streak_text"
                    android:textSize="@dimen/widget_streak_text_size" />
                <TextView
                    android:id="@+id/widget_streak_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/widget_unit_gap"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:textColor="@color/widget_fg_3"
                    android:textSize="@dimen/widget_label_text_size" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_header_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="@dimen/widget_touch_target"
            android:layout_height="@dimen/widget_touch_target">
            <ImageView
                android:id="@+id/widget_refresh"
                android:layout_width="@dimen/widget_touch_target"
                android:layout_height="@dimen/widget_touch_target"
                android:src="@drawable/widget_refresh_icon"
                android:padding="@dimen/widget_refresh_inset"
                android:accessibilityLiveRegion="polite"
                android:contentDescription="@string/widget_refresh" />
            <ProgressBar
                android:id="@+id/widget_refresh_loading"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="@dimen/widget_touch_target"
                android:layout_height="@dimen/widget_touch_target"
                android:indeterminateTint="@color/widget_fg_3"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>
    <ImageView
        android:id="@+id/widget_header_divider"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_hairline"
        android:contentDescription="@null" />

</RelativeLayout>
