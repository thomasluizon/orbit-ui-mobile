<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/widget_row_height">

    <ImageView
        android:id="@+id/item_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_item_bg_fallback" />

    <LinearLayout
        android:id="@+id/widget_item_content"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_row_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/widget_row_inset_inline"
        android:paddingEnd="@dimen/widget_row_inset_inline"
        android:paddingTop="@dimen/widget_row_inset_block"
        android:paddingBottom="@dimen/widget_row_inset_block">

        <ImageView
            android:id="@+id/item_status_icon"
            android:layout_width="@dimen/widget_status_size"
            android:layout_height="@dimen/widget_status_size"
            android:contentDescription="@null"
            android:src="@drawable/widget_status_pending" />

        <LinearLayout
            android:id="@+id/item_title_time_col"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_inline_gap"
            android:layout_marginEnd="@dimen/widget_inline_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/item_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:textColor="@color/widget_item_title"
                    android:textSize="@dimen/widget_title_text_size" />

                <TextView
                    android:id="@+id/item_children_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/widget_badge_height"
                    android:layout_marginStart="@dimen/widget_badge_inset"
                    android:background="@drawable/widget_badge_bg"
                    android:fontFamily="sans-serif"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="@dimen/widget_badge_inset"
                    android:paddingEnd="@dimen/widget_badge_inset"
                    android:textColor="@color/widget_fg_2"
                    android:textSize="@dimen/widget_label_text_size"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/item_checklist_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/widget_badge_height"
                    android:layout_marginStart="@dimen/widget_badge_inset"
                    android:background="@drawable/widget_badge_bg"
                    android:fontFamily="sans-serif"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="@dimen/widget_badge_inset"
                    android:paddingEnd="@dimen/widget_badge_inset"
                    android:textColor="@color/widget_fg_2"
                    android:textSize="@dimen/widget_label_text_size"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/item_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:fontFeatureSettings="tnum"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:textColor="@color/widget_fg_3"
                android:textSize="@dimen/widget_label_text_size"
                android:visibility="gone" />

            <TextView
                android:id="@+id/item_time_overdue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:fontFeatureSettings="tnum"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:textColor="@color/widget_overdue"
                android:textSize="@dimen/widget_label_text_size"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/item_deeper_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/widget_fg_3"
            android:textSize="@dimen/widget_label_text_size"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
