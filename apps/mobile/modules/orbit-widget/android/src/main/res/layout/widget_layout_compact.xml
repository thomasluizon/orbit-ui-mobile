<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top"
    android:background="@drawable/widget_bg_fallback"
    android:clipToOutline="true">

    <!-- Dynamic background (rendered programmatically with theme colors).
         Static fallback drawable guarantees a visible surface if the bitmap is
         not yet applied or fails. -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_fallback"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/widget_inset_card">

        <RelativeLayout
            android:id="@+id/widget_header_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_touch_target"
            android:gravity="center_vertical">
            <LinearLayout
                android:id="@+id/widget_header_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/widget_header_right"
                android:layout_marginEnd="@dimen/widget_inline_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/widget_progress_ring"
                    android:layout_width="@dimen/widget_ring_size"
                    android:layout_height="@dimen/widget_ring_size"
                    android:layout_marginEnd="@dimen/widget_inline_gap"
                    android:importantForAccessibility="no"
                    android:contentDescription="@null"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/widget_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/widget_today"
                    android:textColor="@color/widget_fg_3"
                    android:textSize="@dimen/widget_day_text_size" />
                <TextView
                    android:id="@+id/widget_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/widget_inline_gap"
                    android:maxLines="1"
                    android:textColor="@color/widget_fg_3"
                    android:textSize="@dimen/widget_label_text_size" />
                <LinearLayout
                    android:id="@+id/widget_streak_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/widget_inline_gap"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/widget_streak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:textColor="@color/widget_streak_text"
                        android:textSize="@dimen/widget_streak_text_size" />
                    <TextView
                        android:id="@+id/widget_streak_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/widget_unit_gap"
                        android:maxLines="1"
                        android:textColor="@color/widget_fg_3"
                        android:textSize="@dimen/widget_label_text_size" />
                </LinearLayout>
                <TextView
                    android:id="@+id/widget_next_habit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/widget_inline_gap"
                    android:maxLines="1"
                    android:textColor="@color/widget_fg_1"
                    android:textSize="@dimen/widget_label_text_size"
                    android:visibility="gone" />
            </LinearLayout>
            <FrameLayout
                android:id="@+id/widget_header_right"
                android:layout_width="@dimen/widget_touch_target"
                android:layout_height="@dimen/widget_touch_target"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/widget_refresh"
                    android:layout_width="@dimen/widget_touch_target"
                    android:layout_height="@dimen/widget_touch_target"
                    android:src="@drawable/widget_refresh_icon"
                    android:padding="@dimen/widget_refresh_inset"
                    android:accessibilityLiveRegion="polite"
                    android:contentDescription="@string/widget_refresh" />
                <ProgressBar
                    android:id="@+id/widget_refresh_loading"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="@dimen/widget_touch_target"
                    android:layout_height="@dimen/widget_touch_target"
                    android:indeterminateTint="@color/widget_fg_3"
                    android:accessibilityLiveRegion="polite"
                    android:visibility="gone" />
            </FrameLayout>
        </RelativeLayout>

        <!-- Content area: list, empty message, and loading skeleton overlap so the
             skeleton can cover the area during the cold/first-load window instead of
             leaving the widget blank. -->
        <FrameLayout
            android:id="@+id/widget_content"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_header_list_gap"
            android:minHeight="@dimen/widget_touch_target">

            <!-- Habit list -->
            <ListView
                android:id="@+id/widget_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@android:color/transparent"
                android:dividerHeight="@dimen/widget_row_gap"
                android:scrollbars="vertical"
                android:fadeScrollbars="true"
                android:scrollbarThumbVertical="@drawable/widget_scrollbar_thumb"
                android:fadingEdge="none"
                android:clipToPadding="false" />

            <!-- Empty state (genuinely no habits / signed out) -->
            <LinearLayout
                android:id="@+id/widget_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_all_clear"
                    android:textColor="@color/widget_fg_1"
                    android:textSize="@dimen/widget_title_text_size"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Loading skeleton (shown until habits have been synced at least once,
                 so a freshly added widget never renders as an empty card) -->
            <LinearLayout
                android:id="@+id/widget_loading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_loading"
                android:orientation="vertical"
                android:visibility="gone">
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>
</FrameLayout>
