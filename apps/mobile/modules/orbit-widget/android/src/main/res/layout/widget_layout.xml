<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="top"
    android:background="@drawable/widget_bg_fallback"
    android:clipToOutline="true">

    <!-- Dynamic background (rendered programmatically with theme colors).
         Static fallback drawable guarantees a visible surface if the bitmap is
         not yet applied or fails. -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_fallback"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/widget_inset_card">

        <RelativeLayout
            android:id="@+id/widget_header_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_touch_target">

            <LinearLayout
                android:id="@+id/widget_header_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:paddingStart="@dimen/widget_row_inset_inline"
                android:layout_marginEnd="@dimen/widget_inline_gap"
                android:layout_toStartOf="@id/widget_header_right"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/widget_today"
                    android:textAllCaps="false"
                    android:textColor="@color/widget_fg_3"
                    android:textSize="@dimen/widget_day_text_size" />

                <TextView
                    android:id="@+id/widget_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:textColor="@color/widget_fg_3"
                    android:textSize="@dimen/widget_label_text_size" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_header_right"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/widget_streak_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/widget_streak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/widget_streak_text"
                        android:textSize="@dimen/widget_streak_text_size" />
                    <TextView
                        android:id="@+id/widget_streak_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/widget_unit_gap"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:textColor="@color/widget_fg_3"
                        android:textSize="@dimen/widget_label_text_size" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="@dimen/widget_touch_target"
                    android:layout_height="@dimen/widget_touch_target">
                    <ImageView
                        android:id="@+id/widget_refresh"
                        android:layout_width="@dimen/widget_touch_target"
                        android:layout_height="@dimen/widget_touch_target"
                        android:src="@drawable/widget_refresh_icon"
                        android:padding="@dimen/widget_refresh_inset"
                        android:accessibilityLiveRegion="polite"
                        android:contentDescription="@string/widget_refresh" />
                    <ProgressBar
                        android:id="@+id/widget_refresh_loading"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="@dimen/widget_touch_target"
                        android:layout_height="@dimen/widget_touch_target"
                        android:indeterminateTint="@color/widget_fg_3"
                        android:accessibilityLiveRegion="polite"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
            <ImageView
                android:id="@+id/widget_header_divider"
                android:layout_alignParentBottom="true"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/widget_hairline"
                android:contentDescription="@null" />

        </RelativeLayout>

        <!-- Content area: list, empty message, and loading skeleton overlap so the
             skeleton can cover the area during the cold/first-load window instead of
             leaving the widget blank. -->
        <RelativeLayout
            android:id="@+id/widget_content"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_header_list_gap"
            android:minHeight="@dimen/widget_touch_target">

            <TextView
                android:id="@+id/widget_content_height"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:height="144dp"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"
                android:visibility="invisible" />

            <!-- Habit list -->
            <ListView
                android:id="@+id/widget_list"
                android:layout_alignTop="@id/widget_content_height"
                android:layout_alignBottom="@id/widget_content_height"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@android:color/transparent"
                android:dividerHeight="@dimen/widget_row_gap"
                android:scrollbars="none"
                android:visibility="gone"
                android:fadeScrollbars="true"
                android:fadingEdge="none"
                android:clipToPadding="false" />

            <!-- Empty state (genuinely no habits / signed out) -->
            <LinearLayout
                android:id="@+id/widget_empty"
                android:layout_alignTop="@id/widget_content_height"
                android:layout_alignBottom="@id/widget_content_height"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/widget_row_inset_inline"
                android:paddingEnd="@dimen/widget_row_inset_inline"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_all_clear"
                    android:textColor="@color/widget_fg_1"
                    android:textSize="@dimen/widget_title_text_size"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Loading skeleton (shown until habits have been synced at least once,
                 so a freshly added widget never renders as an empty card) -->
            <LinearLayout
                android:id="@+id/widget_loading"
                android:layout_alignTop="@id/widget_content_height"
                android:layout_alignBottom="@id/widget_content_height"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_loading"
                android:orientation="vertical"
                android:visibility="visible">

                <LinearLayout
                    android:id="@+id/widget_skeleton_1"
                    android:layout_marginBottom="@dimen/widget_row_gap"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/widget_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/widget_row_inset_inline"
                    android:paddingEnd="@dimen/widget_row_inset_inline"
                    android:paddingTop="@dimen/widget_row_inset_block"
                    android:paddingBottom="@dimen/widget_row_inset_block">

                    <ImageView
                        android:layout_width="@dimen/widget_status_size"
                        android:layout_height="@dimen/widget_status_size"
                        android:background="@drawable/widget_skeleton_mark"
                        android:contentDescription="@null" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/widget_skeleton_height"
                        android:layout_marginStart="@dimen/widget_inline_gap"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/widget_skeleton_bar_1"
                            android:layout_width="@dimen/widget_skeleton_width_1"
                            android:layout_height="@dimen/widget_skeleton_height"
                            android:background="@drawable/widget_skeleton_bar"
                            android:contentDescription="@null" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_skeleton_2"
                    android:layout_marginBottom="@dimen/widget_row_gap"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/widget_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/widget_row_inset_inline"
                    android:paddingEnd="@dimen/widget_row_inset_inline"
                    android:paddingTop="@dimen/widget_row_inset_block"
                    android:paddingBottom="@dimen/widget_row_inset_block">

                    <ImageView
                        android:layout_width="@dimen/widget_status_size"
                        android:layout_height="@dimen/widget_status_size"
                        android:background="@drawable/widget_skeleton_mark"
                        android:contentDescription="@null" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/widget_skeleton_height"
                        android:layout_marginStart="@dimen/widget_inline_gap"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/widget_skeleton_bar_2"
                            android:layout_width="@dimen/widget_skeleton_width_2"
                            android:layout_height="@dimen/widget_skeleton_height"
                            android:background="@drawable/widget_skeleton_bar"
                            android:contentDescription="@null" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_skeleton_3"
                    android:layout_marginBottom="@dimen/widget_row_gap"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/widget_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/widget_row_inset_inline"
                    android:paddingEnd="@dimen/widget_row_inset_inline"
                    android:paddingTop="@dimen/widget_row_inset_block"
                    android:paddingBottom="@dimen/widget_row_inset_block">

                    <ImageView
                        android:layout_width="@dimen/widget_status_size"
                        android:layout_height="@dimen/widget_status_size"
                        android:background="@drawable/widget_skeleton_mark"
                        android:contentDescription="@null" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/widget_skeleton_height"
                        android:layout_marginStart="@dimen/widget_inline_gap"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/widget_skeleton_bar_3"
                            android:layout_width="@dimen/widget_skeleton_width_3"
                            android:layout_height="@dimen/widget_skeleton_height"
                            android:background="@drawable/widget_skeleton_bar"
                            android:contentDescription="@null" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_skeleton_4"
                    android:layout_marginBottom="@dimen/widget_row_gap"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/widget_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/widget_row_inset_inline"
                    android:paddingEnd="@dimen/widget_row_inset_inline"
                    android:paddingTop="@dimen/widget_row_inset_block"
                    android:paddingBottom="@dimen/widget_row_inset_block">

                    <ImageView
                        android:layout_width="@dimen/widget_status_size"
                        android:layout_height="@dimen/widget_status_size"
                        android:background="@drawable/widget_skeleton_mark"
                        android:contentDescription="@null" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/widget_skeleton_height"
                        android:layout_marginStart="@dimen/widget_inline_gap"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/widget_skeleton_bar_4"
                            android:layout_width="@dimen/widget_skeleton_width_4"
                            android:layout_height="@dimen/widget_skeleton_height"
                            android:background="@drawable/widget_skeleton_bar"
                            android:contentDescription="@null" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_skeleton_5"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/widget_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/widget_row_inset_inline"
                    android:paddingEnd="@dimen/widget_row_inset_inline"
                    android:paddingTop="@dimen/widget_row_inset_block"
                    android:paddingBottom="@dimen/widget_row_inset_block">

                    <ImageView
                        android:layout_width="@dimen/widget_status_size"
                        android:layout_height="@dimen/widget_status_size"
                        android:background="@drawable/widget_skeleton_mark"
                        android:contentDescription="@null" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/widget_skeleton_height"
                        android:layout_marginStart="@dimen/widget_inline_gap"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/widget_skeleton_bar_5"
                            android:layout_width="@dimen/widget_skeleton_width_5"
                            android:layout_height="@dimen/widget_skeleton_height"
                            android:background="@drawable/widget_skeleton_bar"
                            android:contentDescription="@null" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>
</FrameLayout>
