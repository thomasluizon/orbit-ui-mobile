<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dynamic background (rendered programmatically with theme colors).
         Static fallback drawable guarantees a visible surface if the bitmap is
         not yet applied or fails. -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_fallback"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header: a fixed two-line day summary with the streak on the right. -->
        <RelativeLayout
            android:id="@+id/widget_header_container"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:id="@+id/widget_header_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/widget_header_right"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    android:text="@string/widget_today"
                    android:textAllCaps="true"
                    android:textColor="@color/widget_fg_3"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/widget_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:textColor="@color/widget_fg_3"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_header_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/widget_streak_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/widget_streak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/widget_streak_text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/widget_streak_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/widget_streak_unit"
                        android:textColor="@color/widget_fg_3"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Refresh button -->
                <ImageView
                    android:id="@+id/widget_refresh"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/widget_refresh_icon"
                    android:padding="12dp"
                    android:contentDescription="@string/widget_refresh" />

                <!-- Loading spinner (shown during refresh, hidden by default) -->
                <ProgressBar
                    android:id="@+id/widget_refresh_loading"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:indeterminateTint="@color/widget_fg_3"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- FrameLayout, not View: RemoteViews only inflates classes annotated @RemoteView,
                 and android.view.View is not one of them. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_alignParentBottom="true"
                android:background="@color/widget_hairline" />
        </RelativeLayout>

        <!-- Content area: list, empty message, and loading skeleton overlap so the
             skeleton can cover the area during the cold/first-load window instead of
             leaving the widget blank. -->
        <FrameLayout
            android:id="@+id/widget_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Habit list -->
            <ListView
                android:id="@+id/widget_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:scrollbars="vertical"
                android:fadeScrollbars="true"
                android:scrollbarThumbVertical="@drawable/widget_scrollbar_thumb"
                android:fadingEdge="none"
                android:clipToPadding="false" />

            <!-- Empty state (genuinely no habits / signed out) -->
            <LinearLayout
                android:id="@+id/widget_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_all_clear"
                    android:textColor="@color/widget_fg_1"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Loading skeleton (shown until habits have been synced at least once,
                 so a freshly added widget never renders as an empty card) -->
            <LinearLayout
                android:id="@+id/widget_loading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_loading"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/widget_skeleton_1"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/widget_skeleton_mark"
                        android:contentDescription="@null" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/widget_skeleton_bar_1"
                            android:layout_width="150dp"
                            android:layout_height="12dp"
                            android:background="@drawable/widget_skeleton_bar"
                            android:contentDescription="@null" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_skeleton_2"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/widget_skeleton_mark"
                        android:contentDescription="@null" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/widget_skeleton_bar_2"
                            android:layout_width="126dp"
                            android:layout_height="12dp"
                            android:background="@drawable/widget_skeleton_bar"
                            android:contentDescription="@null" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_skeleton_3"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/widget_skeleton_mark"
                        android:contentDescription="@null" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/widget_skeleton_bar_3"
                            android:layout_width="102dp"
                            android:layout_height="12dp"
                            android:background="@drawable/widget_skeleton_bar"
                            android:contentDescription="@null" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_skeleton_4"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/widget_skeleton_mark"
                        android:contentDescription="@null" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/widget_skeleton_bar_4"
                            android:layout_width="78dp"
                            android:layout_height="12dp"
                            android:background="@drawable/widget_skeleton_bar"
                            android:contentDescription="@null" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_skeleton_5"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/widget_skeleton_mark"
                        android:contentDescription="@null" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/widget_skeleton_bar_5"
                            android:layout_width="54dp"
                            android:layout_height="12dp"
                            android:background="@drawable/widget_skeleton_bar"
                            android:contentDescription="@null" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>
</FrameLayout>
