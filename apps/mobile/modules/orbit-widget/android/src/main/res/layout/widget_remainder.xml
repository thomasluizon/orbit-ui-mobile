<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_remainder"
    android:layout_width="match_parent"
    android:layout_height="@dimen/widget_row_height">

    <TextView
        android:id="@+id/widget_remainder_text"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_ring_size"
        android:layout_gravity="center_vertical"
        android:fontFamily="sans-serif"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="@dimen/widget_row_inset_inline"
        android:paddingEnd="@dimen/widget_row_inset_inline"
        android:textColor="@color/widget_fg_3"
        android:textSize="@dimen/widget_label_text_size" />

</FrameLayout>
