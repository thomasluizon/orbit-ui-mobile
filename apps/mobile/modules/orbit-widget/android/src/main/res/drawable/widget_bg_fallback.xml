<?xml version="1.0" encoding="utf-8"?>
<!-- Static generated card and hairline so the widget is never transparent before/if
     the programmatic theme bitmap is applied. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_card" />
    <stroke android:width="1dp" android:color="@color/widget_hairline" />
    <corners android:radius="24dp" />
</shape>
