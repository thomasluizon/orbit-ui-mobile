{
  "productName": "Orbit",
  "identifier": "org.useorbit.desktop",
  "build": {
    "frontendDist": "https://app.useorbit.org"
  },
  "app": {
    "security": {
      "capabilities": [{
        "identifier": "desktop-auth",
        "local": false,
        "remote": { "urls": ["https://app.useorbit.org/*"] },
        "windows": ["main"],
        "permissions": ["allow-commit-desktop-login"]
      }]
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Orbit",
        "url": "https://app.useorbit.org",
        "incognito": false
      }
    ]
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["org.useorbit.desktop"] } },
    "updater": {
      "endpoints": ["https://github.com/thomasluizon/orbit-ui-mobile/releases/download/desktop-production/latest.json"],
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
