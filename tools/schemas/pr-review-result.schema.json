{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orbit Codex PR review result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "pullRequest",
    "base",
    "reviewedHead",
    "verdict",
    "summary",
    "findings",
    "positives",
    "recommendation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "pullRequest": {
      "type": "integer",
      "minimum": 1
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "reviewedHead": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "verdict": {
      "enum": ["APPROVE", "NEEDS_WORK"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "title", "path", "line", "evidence", "remediation"],
        "properties": {
          "severity": {
            "enum": ["Critical", "High"]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "remediation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "positives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommendation": {
      "type": "string",
      "minLength": 1
    }
  }
}
