{
  "worker": "codex",
  "reviewer": "claude",
  "workers": {
    "codex": {
      "command": "codex",
      "args": [
        "exec",
        "-c",
        "windows.sandbox=\"unelevated\"",
        "--dangerously-bypass-approvals-and-sandbox"
      ],
      "models": {
        "default": {
          "model": "gpt-5.6-sol",
          "args": ["-c", "model_reasoning_effort=\"high\""]
        },
        "review": {
          "model": "gpt-5.6-sol",
          "args": ["-c", "model_reasoning_effort=\"xhigh\""]
        }
      }
    },
    "claude": {
      "command": "claude",
      "args": ["--permission-mode", "bypassPermissions", "--print"],
      "models": {
        "default": {
          "model": "opus",
          "args": ["--effort", "high"]
        },
        "review": {
          "model": "opus",
          "args": ["--effort", "high"]
        }
      }
    }
  },
  "timeouts": {
    "hardCeilingMinutes": 45,
    "noProgressMinutes": 10,
    "pollSeconds": 60
  },
  "caps": {
    "reviewRounds": 2,
    "parallelTickets": 3,
    "botReviewWaitSeconds": 900,
    "connectorFixAttempts": 3
  },
  "linear": {
    "team": "ORB",
    "workspace": "useorbitai",
    "states": {
      "working": "In Progress",
      "review": "In Review",
      "done": "Done"
    }
  },
  "repos": {
    "ui": "C:\\Users\\thoma\\Documents\\Programming\\Projects\\orbit-ui-mobile",
    "api": "C:\\Users\\thoma\\Documents\\Programming\\Projects\\orbit-api",
    "landing": "C:\\Users\\thoma\\Documents\\Programming\\Projects\\orbit-landing-page"
  }
}
