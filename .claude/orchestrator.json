{
  "worker": "claude",
  "relay": { "enabled": true, "softTokens": 300000, "hardTokens": 360000 },
  "pace": {
    "enabled": true,
    "workerCap": 3,
    "recheckMinutes": 5,
    "maxHoldMinutes": 60,
    "launchGateAllowanceMinutes": 10,
    "backgroundLimitMinutes": 120,
    "transcriptRoot": "~/.claude/projects",
    "weeklyReset": { "weekday": 4, "hour": 4, "minute": 0, "utcOffsetMinutes": -180 },
    "tokenWeights": { "input": 1, "cacheWrite5m": 1.25, "cacheWrite1h": 2, "cacheRead": 0.1, "output": 5 },
    "modelWeights": { "opus": 1.7, "sonnet": 1, "default": 1.7 },
    "source": "Weekly reset: Thursday 04:00 at UTC-3, set by the owner. Token weights are multiples of the input price and model weights are multiples of the Sonnet price, both measured on run record #2179 (D878). The worker cap is the three-worker pace of that record. The whole launcher process runs as a Bash background task with timeout 7200000 (.claude/playbooks/operations.md), which is backgroundLimitMinutes. The hold (maxHoldMinutes), the launch gate allowance and one worker run (timeouts.hardCeilingMinutes) must add up to less than that limit: 60 + 10 + 45 = 115. The launcher enforces the allowance: its wait at the launch gate ends after launchGateAllowanceMinutes with exit 10. Ticket work and a read-only run with a second Claude account can relaunch once after a usage limit, so each shortens the hold by one more worker run. Research never relaunches."
  },
  "workers": {
    "codex": {
      "command": "codex",
      "args": [
        "exec",
        "--disable",
        "apps",
        "--ignore-user-config",
        "--dangerously-bypass-approvals-and-sandbox"
      ],
      "subagentOffArgs": ["--disable", "multi_agent"],
      "models": {
        "default": {
          "model": "gpt-6.1-sol",
          "args": [
            "-c",
            "model_reasoning_effort=\"high\""
          ]
        },
        "mechanical": {
          "model": "gpt-6.1-sol",
          "args": [
            "-c",
            "model_reasoning_effort=\"medium\""
          ]
        },
        "deep": {
          "model": "gpt-6.1-sol",
          "args": [
            "-c",
            "model_reasoning_effort=\"xhigh\""
          ]
        },
        "max": {
          "model": "gpt-6.1-sol",
          "args": [
            "-c",
            "model_reasoning_effort=\"max\""
          ]
        }
      }
    },
    "claude": {
      "command": "claude",
      "configDirEnv": "ORBIT_WORKER_CLAUDE_CONFIG_DIR",
      "args": [
        "-p",
        "--output-format",
        "stream-json",
        "--verbose",
        "--strict-mcp-config",
        "--permission-mode",
        "bypassPermissions"
      ],
      "subagentOffArgs": ["--disallowed-tools", "Task"],
      "models": {
        "default": {
          "model": "claude-fable-5-2",
          "args": ["--effort", "high"]
        },
        "mechanical": {
          "model": "claude-fable-5-2",
          "args": ["--effort", "high"]
        },
        "deep": {
          "model": "claude-fable-5-2",
          "args": ["--effort", "high"]
        },
        "max": {
          "model": "claude-fable-5-2",
          "args": ["--effort", "high"]
        }
      }
    }
  },
  "classifier": {
    "model": "claude-sonnet-5-5"
  },
  "timeouts": {
    "hardCeilingMinutes": 45,
    "cloudCeilingMinutes": 45,
    "cloudCommandMinutes": 10,
    "gitRemoteSeconds": 30,
    "receiptLockSeconds": 1,
    "noProgressMinutes": 10,
    "measurementNoProgressMinutes": 25,
    "pollSeconds": 60
  },
  "caps": {
    "maxOpenPullRequests": 200,
    "maxQueuedRuns": 1000,
    "parallelTickets": 40,
    "cloudParallelTasks": 8,
    "reviewFixAttempts": 3,
    "workerLaunchesPerBranch": 2,
    "workerLogMegabytes": 512
