{
  "_comment": "Copy this file to .mcp.json (gitignored) and fill in the ${...} values. It declares only the MCP servers that a skill in this repository calls: render and sentry (hosted HTTP integrations, read by /investigate) and csharp-lsp (the Roslyn-backed CWM.RoslynNavigator MCP server, read by /investigate; install it once with `dotnet tool install -g CWM.RoslynNavigator`, which needs the .NET 10 SDK). Point csharp-lsp at the Orbit.slnx of orbit-api with --solution, so C# navigation works when the session starts from orbit-ui-mobile.",
  "mcpServers": {
    "render": {
      "type": "http",
      "url": "https://mcp.render.com/mcp",
      "headers": {
        "Authorization": "Bearer ${RENDER_MCP_TOKEN}"
      }
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "csharp-lsp": {
      "command": "${CSHARP_LSP_COMMAND}",
      "args": ["--solution", "${ORBIT_API_SOLUTION}"],
      "timeout": 60000
    }
  }
}
